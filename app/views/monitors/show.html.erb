<div class="max-w-4xl mx-auto px-4 py-8">
  <%= render 'shared/flashes' %>

  <div class="mb-4">
    <%= link_to project_monitors_path(@project), class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      Back to Monitors
    <% end %>
  </div>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @monitor.name %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @monitor.url %></p>
    </div>
    <div class="flex items-center space-x-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @monitor.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
        <%= @monitor.status %>
      </span>
      <%= button_to @monitor.status == 'active' ? 'Pause' : 'Resume', toggle_project_monitor_path(@project, @monitor), method: :post, class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      <%= button_to "Run Now", run_now_project_monitor_path(@project, @monitor), method: :post, class: "inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      <%= link_to "Edit", edit_project_monitor_path(@project, @monitor), class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
    </div>
  </div>

  <%# Stats %>
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white shadow rounded-lg p-4 text-center">
      <p class="text-sm text-gray-500">Total Runs</p>
      <p class="text-2xl font-bold text-gray-900"><%= @runs.size %></p>
    </div>
    <div class="bg-white shadow rounded-lg p-4 text-center">
      <p class="text-sm text-gray-500">Pass Rate</p>
      <% pass_rate = @runs.any? ? (@runs.count { |r| r.status == 'pass' } * 100.0 / @runs.size).round(1) : 0 %>
      <p class="text-2xl font-bold <%= pass_rate == 100 ? 'text-green-600' : pass_rate >= 80 ? 'text-yellow-600' : 'text-red-600' %>"><%= pass_rate %>%</p>
    </div>
    <div class="bg-white shadow rounded-lg p-4 text-center">
      <p class="text-sm text-gray-500">Avg Duration</p>
      <% avg_ms = @runs.any? ? (@runs.sum(&:duration_ms).to_f / @runs.size).round : 0 %>
      <p class="text-2xl font-bold text-gray-900"><%= avg_ms %> ms</p>
    </div>
  </div>

  <%# Steps Preview %>
  <div class="bg-white shadow rounded-lg p-4 mb-8">
    <h2 class="text-sm font-medium text-gray-700 mb-3">Test Steps</h2>
    <ol class="space-y-2">
      <% @monitor.steps.each_with_index do |step, i| %>
        <li class="flex items-center text-sm">
          <span class="text-gray-400 w-6"><%= i + 1 %>.</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 mr-2"><%= step['action'] %></span>
          <span class="text-gray-600">
            <% case step['action'] %>
            <% when 'visit' %>
              <%= step['url'] %>
            <% when 'click' %>
              <%= step['selector'] %>
            <% when 'fill_in' %>
              <%= step['selector'] %> = "<%= step['value'] %>"
            <% when 'expect_text' %>
              "<%= step['text'] %>"
            <% end %>
          </span>
        </li>
      <% end %>
    </ol>
  </div>

  <%# Run History %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <h2 class="text-sm font-medium text-gray-700 p-4 border-b">Run History</h2>
    <% if @runs.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Duration</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Error</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @runs.each do |run| %>
            <tr>
              <td class="px-4 py-3">
                <% if run.status == 'pass' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Pass</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Fail</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= run.duration_ms %> ms</td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= run.completed_at.strftime('%b %d, %H:%M') %></td>
              <td class="px-4 py-3 text-sm text-red-600"><%= truncate(run.error_message, length: 80) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="p-4 text-sm text-gray-500">No runs yet. Click "Run Now" to execute the first test.</p>
    <% end %>
  </div>
</div>
