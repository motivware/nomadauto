<%= form_for([@project, @part]) do |f| %>
  <%= f.label :name %>
  <%= f.text_field :name, autofocus: true, class: 'form-control' %>
  <%= f.label :description %>
  <%= f.text_area :description, autofocus: true, class: 'form-control' %>
  <%= f.label :price %>
  <%= f.number_field :price, autofocus: true, class: 'form-control' %>
  <%= f.label :quantity %>
  <%= f.number_field :quantity, autofocus: true, class: 'form-control' %>
  <%= f.label :part_number %>
  <%= f.text_area :part_number, autofocus: true, class: 'form-control' %>
  <%= f.label "Vehicle" %>
  <%= f.collection_select :vehicle_id, Vehicle.order(:model), :id, :model_make_year, autofocus: true, class: 'form-control' %>
  </br>
  <%= f.submit "Submit", class: 'btn btn-primary' %>
<% end %>