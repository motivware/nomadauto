<%= render 'users/sidebar' %></br>

<div class="container-fluid">
  <div class="jumbotron">
    <div class="row">
      <div class="col-md-14">
        <%= link_to "Udate Profile", edit_project_profile_path(@project, @profile), class: 'btn btn-default' %>
          <p></p>
      <br/><br/>
        <h3><%= @profile.first_name %> <%= @profile.last_name %></h3>
        <h3><%= @profile.street_address %></h3>
        <h3><%= @profile.city %>, <%= @profile.state %> <%= @profile.zipcode %></h3>
        <h3><br/><br/><%= image_tag(@profile.avatar.url(:thumb)) %></h3>
    </div>
  </div>
</div>
