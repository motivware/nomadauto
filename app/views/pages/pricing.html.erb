<% @title="| Pricing" %>

<div class="bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-3xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Simple, Transparent Pricing</h1>
      <p class="mt-4 text-lg text-gray-500">
        One plan, everything included. Start with a free 30-day trial.
      </p>
    </div>

    <div class="max-w-md mx-auto">
      <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm text-center">
        <h2 class="text-lg font-semibold text-gray-900">Pro</h2>
        <div class="mt-4 flex items-baseline justify-center gap-1">
          <span class="text-5xl font-bold tracking-tight text-gray-900">$49</span>
          <span class="text-lg font-medium text-gray-500">/month</span>
        </div>
        <p class="mt-2 text-sm text-gray-500">after 30-day free trial</p>

        <ul class="mt-8 space-y-4 text-left">
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-indigo-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-base text-gray-600">Unlimited monitors</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-indigo-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-base text-gray-600">Schedules from every 5 minutes to daily</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-indigo-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-base text-gray-600">Email alerts with screenshots and error details</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-indigo-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-base text-gray-600">No-code test builder</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-indigo-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-base text-gray-600">Uptime and performance dashboard</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-indigo-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-base text-gray-600">Invite unlimited team members</span>
          </li>
        </ul>

        <div class="mt-8">
          <%= link_to "Start Free Trial", signup_path(plan: @basic_plan.id),
                class: "w-full inline-flex items-center justify-center px-6 py-3 text-base font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition" %>
        </div>
        <p class="mt-3 text-sm text-gray-500">No credit card required</p>
      </div>
    </div>
  </div>
</div>
