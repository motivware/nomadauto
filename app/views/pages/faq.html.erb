<% @title="Frequently Asked Questions" %>

<!-- This example requires Tailwind CSS v2.0+ -->
<div class="bg-white">
  <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:py-20 lg:px-8">
    <div class="lg:grid lg:grid-cols-3 lg:gap-8">
      <div>
        <h2 class="text-3xl font-extrabold text-gray-900">Frequently asked questions</h2>
        <p class="mt-4 text-lg text-gray-500">Can’t find the answer you’re looking for? Reach out to us and we will respond promptly. </p>
        <br/> <%= link_to "Contact Us", new_contact_path, class: 'w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 md:py-4 md:text-lg md:px-10' %>
      </div>
      <div class="mt-12 lg:mt-0 lg:col-span-2">
        <dl class="space-y-12">
          <div>
            <dt class="text-lg leading-6 font-medium text-gray-900">What can I do with the trial period?</dt>
            <dd class="mt-2 text-base text-gray-500">The trial period provides you with all functionality to be utilized for 30 days.</dd>
          </div>

          <div>
            <dt class="text-lg leading-6 font-medium text-gray-900">When can I cancel my account?</dt>
            <dd class="mt-2 text-base text-gray-500">Feel free to cancel your account at anytime.</dd>
          </div>

          <div>
            <dt class="text-lg leading-6 font-medium text-gray-900">What forms of payment are accepted?</dt>
            <dd class="mt-2 text-base text-gray-500">All major credit cards.</dd>
          </div>

          <div>
            <dt class="text-lg leading-6 font-medium text-gray-900">Is a credit card required to use Motivware?</dt>
            <dd class="mt-2 text-base text-gray-500">For the first 30 days you can use Motivware without a credit card.</dd>
          </div>
          <!-- More questions... -->
        </dl>
      </div>
    </div>
  </div>
</div>