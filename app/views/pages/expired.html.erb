<% @title="| Trial Expired" %>

<div class="bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-2xl mx-auto px-4 py-24 sm:py-32 text-center">
    <div class="mx-auto flex items-center justify-center w-16 h-16 rounded-full bg-indigo-50 mb-6">
      <svg class="w-8 h-8 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
      Your free trial has ended
    </h1>
    <p class="mt-4 text-lg text-gray-500 leading-relaxed">
      Your 30-day trial is over, but your monitors and data are still here. Subscribe to pick up right where you left off.
    </p>
    <div class="mt-8">
      <%= button_to "Subscribe — $49/mo", checkout_path, method: :post,
            class: "inline-flex items-center justify-center px-8 py-3 text-base font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition" %>
    </div>
    <p class="mt-3 text-sm text-gray-500">Cancel anytime. No long-term contracts.</p>
  </div>
</div>
