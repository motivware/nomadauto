<div class="invoice-box">
  <table cellpadding="0" cellspacing="0">
    <tr class="top">
      <td colspan="4">
        <table>
          <tr>
            <td class="title">
              <%= image_tag wicked_pdf_asset_base64('logo.svg') %>
            </td>
            <td>
              <b>Invoice #:</b> <%= @invoice.id %><br>
              <b>Created:</b> <%= @invoice.created_at.strftime('%Y-%d-%m') %><br>
              <b>Due Date:</b> <%= @invoice.date %>
              <br>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr class="information">
      <td colspan="4">
        <table>
          <tr>
            <td>
              <b>Name:</b> <%= @customer.first.last_name %>,
                       <%= @customer.first.first_name %><br>
              <b>Phone Number: </b><%= @customer.first.phone_number %><br>
              <b>Email:</b> <%= @customer.first.email %>
            </td>

             <td>
              <b>Make:</b> <%= @vehicle.first.make %><br>
              <b>Model:</b> <%= @vehicle.first.model %><br>
              <b>Mileage:</b> <%= @vehicle.first.miles %><br>
              <b>Vin:</b> <%= @vehicle.first.vin %></b>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr class="heading">
    <table>
      <tr>
        <h2>Parts</h2>
        <td><b>Item</b></td>
        <td class="right"><b>Description</b></td>
        <td class="right"><b>Qty</b></td>
        <td class="right"><b>Price</b></td>
      </tr>
    </tr>

      <tr class="details">
        <td colspan="16">
          <% @parts.each do |item| %>
            <tr class="item">
                <td>
                    <%= @parts.first.name %><br>
                </td>

                <td class="right">
                  <%= @parts.first.description %>
                </td>

                <td class="right">
                  <%= @parts.first.quantity %>
                </td>


                <td class="right">
                  <%= @parts.first.price %>
                </td>
            </tr>
          <% end %>
        </td>
      </tr>
    </table>
    </tr>

    <tr class="heading">
        <table>
          <tr>
            <h2><b>Labor</b></h2>
            <td><b>Title</b></td>
            <td class="right"><b>Description</b></td>
            <td class="right"><b>Technichian</b></td>
            <td class="right"><b>Price</b></td>
          </tr>

      <tr class="details">
        <td colspan="16">
          <% @parts.each do |item| %>
            <tr class="item">
                <td>
                  <%= @workorders.first.title %><br>
                </td>

                <td class="right">
                  <%= @workorders.first.owner %>
                </td>

                <td class="right">
                  <%= @workorders.first.description %>
                </td>

                <td class="right">
                  <%= @workorders.first.charge %>
                </td>
            </tr>
          <% end %>
        </td>
       </tr>
      </table>
      </tr>

  <table>
    <br>
    <tr>
      <td colspan="2"></td>
      <td><b>Subtotal:</b><%= @workorders.first.charge + @parts.first.price %></td>
      <td></td>
    </tr>

    <tr>
      <td colspan="2"></td>
      <td><b>Sales Tax </b><%= @workorders.first.charge + @parts.first.price * 0.06 %></td>
      <td></td>
    </tr>

    <tr class="heading">
      <td colspan="2"></td>
      <td><b>TOTAL:</b> <%= (@workorders.first.charge + @parts.first.price * 0.06) + @workorders.first.charge + @parts.first.price %></td>
      <td>
         <b></b>
      </td>
    </tr>
  </table>
</div>

