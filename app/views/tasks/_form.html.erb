<!--
  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<div class="space-y-8 divide-y divide-gray-200 sm:space-y-5">
	<div>
		<div>
			<h3 class="text-lg leading-6 font-medium text-gray-900">Task</h3>
			<p class="mt-1 max-w-2xl text-sm text-gray-500">This information will be displayed for you and your team to reference.</p>
		</div>
    <%= form_for([@task.project, @task]) do |f| %>
	<div class="pt-8 space-y-6 sm:pt-10 sm:space-y-5">
		<div class="space-y-6 sm:space-y-5">
			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
			    <%= f.label :title, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :title, autofocus: true, placeholder: 'Title', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :description, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :description, autofocus: true, placeholder: 'Description', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :status, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.select :status, options_for_select([['Open'],['Pending'],['Closed']]), { include_blank: 'Select status' }, class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">	
				<%= f.label :priority, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
                <%= f.select :priority, options_for_select([['High'],['Medium'],['Low']]), { include_blank: 'Select status' }, class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :owner, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
                <% options_from_collection_for_select(current_account.user_users, :name, :name) %>
                <%= f.collection_select(:owner, current_account.user_users, :name, :name, { include_blank: 'Select owner' }, class: "max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md" ) %>
			</div>

                <%= f.hidden_field :user_id, value: current_user.id, readonly: true, class: 'form-control' %>
   
			<div class="pt-5">
				<%= f.submit "Save", class: 'inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto' %>
			</div>
			<% end %>
		</div>
	</div>
</div>

