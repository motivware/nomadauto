<%= render 'users/sidebar' %></br>
<div class="container-fluid">
<h3>Search a vehicle's VIN number and get the vehicle year, make, model, engine and additional data!</h3>
<br/> 
  <form>
    <label>Vin Number</label>
    <input type="text" id="vinlookup" class="form-control">
    <button type="button" onclick="fetchVINAPI()" value="Submit" class="btn btn-default">Vechicle Lookup</button>
  </form>
</div>
<div class="container-fluid">
  <div class="jumbotron">
    <div class="row">
      <div class="col-md-14">
        <%= render 'form' %>
      </div>
    </div>
  </div>
</div>