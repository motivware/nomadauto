<%= form_for([@project, @vehicle]) do |f| %>
  <%= f.label :vin %>
  <%= f.text_field :vin, autofocus: true, class: 'form-control' %>
  <%= f.label :make %>
  <%= f.text_field :make, autofocus: true, class: 'form-control' %>
  <%= f.label :model %>
  <%= f.text_field :model, autofocus: true, class: 'form-control' %>
  <%= f.label :year %>
  <%= f.select :year, Date.today.year-50.. 8.years.from_now.year, autofocus: true, class: 'form-control' %>
  <%= f.label :miles %>
  <%= f.text_field :miles, autofocus: true, class: 'form-control' %>
  <%= f.label :engine %>
  <%= f.text_field :engine, autofocus: true, class: 'form-control' %>
  <%= f.label :license_plate %>
  <%= f.text_field :license_plate, autofocus: true, class: 'form-control' %>
  <%= f.label :transmission %>
  <%= f.text_field :transmission, autofocus: true, class: 'form-control' %>
  </br>
  <%= f.submit "Submit", class: 'btn btn-primary' %>
<% end %>
