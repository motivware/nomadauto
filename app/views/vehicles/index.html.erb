<%= render 'users/sidebar' %></br>

<div class="container-fluid">
  <div class="col-md-16 col-md-offset-0">
    <%= link_to "Add New Vehicle", new_project_vehicle_path, :class => "btn btn-default" %></br></br>
  </div>
  <div class="table-responsive">
    <table class="table">
      <tr>
        <th>VIN</th>
        <th>Make</th>
        <th>Model</th>
        <th>Year</th>
        <th>Miles</th>
        <th>Engine</th>
        <th>License Plate</th>
        <th>Transmission</th>
        <th>Last Updated</th>
      </tr>
      <% @vehicles.each do |vehicle| %>
        <tr>
          <td><%= vehicle.vin %></td>
          <td><%= vehicle.make %></td>
          <td><%= vehicle.model %></td>
          <td><%= vehicle.year %></td>
          <td><%= vehicle.miles %></td>
          <td><%= vehicle.engine %></td>
          <td><%= vehicle.license_plate %></td>
          <td><%= vehicle.transmission %></td>
          <td><%= vehicle.updated_at %></td>
        </tr>
      <% end %>
    </table>
  </div>
</div>