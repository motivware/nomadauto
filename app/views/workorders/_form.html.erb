<%= form_for([@workorder.project, @workorder]) do |f| %>
    <%= f.label :title %>
    <%= f.text_field :title, class: 'form-control' %>

    <%= f.label :description %>
    <%= f.text_area :description, class: 'form-control' %>

    <%= f.label :status %>
    <%= f.select :status, options_for_select([['Open'],['Pending'],['Closed']]), { include_blank: 'Select status' }, class: "form-control"  %>

    <%= f.label :priority %>
    <%= f.select :priority, options_for_select([['High'],['Medium'],['Low']]), { include_blank: 'Select priority' }, class: "form-control" %>

    <%= f.label :owner %>
    <% options_from_collection_for_select(current_account.user_users, :name, :name) %>
    <%= f.collection_select(:owner, current_account.user_users, :name, :name, { include_blank: 'Select owner' }, class: "form-control" ) %>

    <%= f.hidden_field :user_id, value: current_user.id, readonly: true, class: 'form-control' %>

    <%= f.label :vehicle_id, "Vehicle" %>
    <%= f.collection_select :vehicle_id, Vehicle.order(:model), :id, :model_make_year, { include_blank: 'Select a vehicle' }, class: "form-control" %>

    <%= f.label :time %>
    <%= f.text_field :time, class: 'form-control' %>

    <%= f.label :charge %>
    <%= f.text_field :charge, class: 'form-control' %>

    </br>
    <%= f.submit "Submit", class: 'btn btn-primary' %>
<% end %>
<td><%= link_to "delete", [@workorder.project, @workorder, @activities], method: :delete, data: { confirm: "Are you sure?" } %></td>
<td><%= link_to "Back", project_workorders_path(@project) %></td>
