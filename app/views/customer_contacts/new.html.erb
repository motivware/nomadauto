<% @title="| Contact Us" %>

<div class="bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Get in Touch</h1>
      <p class="mt-4 max-w-xl mx-auto text-lg text-gray-500 leading-relaxed">
        Have a question about SynthMonitor or want to see it in action? We'd love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <div class="lg:col-span-2">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-gray-900">Contact Info</h2>
          <p class="mt-3 text-base text-gray-500 leading-relaxed">
            Whether you're evaluating SynthMonitor for your team or have a technical question, we're here to help.
          </p>
          <div class="mt-6 flex items-center gap-3">
            <svg class="flex-shrink-0 h-5 w-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span class="text-base text-gray-600"><%= mail_to 'support@synthmonitor.com' %></span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-3">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <%= form_for @customer_contacts do |f| %>
            <div class="space-y-5">
              <div>
                <%= f.label :name, "Full Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :name, placeholder: 'Jane Smith', class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
              </div>
              <div>
                <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :email, placeholder: 'jane@company.com', class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
              </div>
              <div>
                <%= f.label :comments, "Message", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_area :comments, class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm', placeholder: 'Tell us what you\'re looking for...', rows: "6" %>
              </div>
              <%= recaptcha_tags %>
              <div class="pt-2">
                <%= f.submit 'Send Message', class: 'cursor-pointer inline-flex items-center justify-center px-6 py-2.5 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
