<%= render 'users/sidebar' %></br>

<div class="container-fluid">
  <div class="col-md-16 col-md-offset-0">
    <%= link_to "Add New Customer", new_project_customer_path, :class => "btn btn-default" %></br></br>
  </div>
  <div class="table-responsive">
    <table class="table">
      <tr>
          <th>Customer</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Phone Number</th>
          <th>Website</th>
          <th>Email</th>
          <th></th>
          <th></th>
      </tr>
      <%if Customer.exists? %>
        <% @customers.each do |customer| %>
            <tr>
              <td><%= link_to customer.company, edit_project_customer_path(@project, customer) %></td>
              <td><%= customer.first_name %></td>
              <td><%= customer.last_name %></td>
              <td><%= customer.phone_number %></td>
              <td><%= customer.website %></td>
              <td><%= customer.email %></td>
            </tr>
        <% end %>
      <% end %>
    </table>
  </div>
</div>
