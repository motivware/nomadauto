<%= render 'users/sidebar' %><br/>
<%= render 'shared/flashes' %>

<!--
  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<div class="max-w-lg mx-auto">
  <div>
    <div class="text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 48 48" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M34 40h10v-4a6 6 0 00-10.712-3.714M34 40H14m20 0v-4a9.971 9.971 0 00-.712-3.714M14 40H4v-4a6 6 0 0110.713-3.714M14 40v-4c0-1.313.253-2.566.713-3.714m0 0A10.003 10.003 0 0124 26c4.21 0 7.813 2.602 9.288 6.286M30 14a6 6 0 11-12 0 6 6 0 0112 0zm12 6a4 4 0 11-8 0 4 4 0 018 0zm-28 0a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <h2 class="mt-2 text-lg font-medium text-gray-900">Add team members</h2>
      <p class="mt-1 text-sm text-gray-500">As the owner of this project, you can add new team members.</p>
      <br/>
       <% if @user.plan_id == 1 %>
          <p> You have <span style="color:red"><%= remaining_days %> Days left </span>with your free acount! <%= link_to "Suscribe Now", edit_user_path(current_user, plan: @pro_plan.id) %> to add the rest of your team!</p>
      <% else @user.plan_id == 2 %>
      <%= form_for @invite, :url => project_invites_path, class: 'mt-6 flex-row' do |f| %>
          <%= f.hidden_field :subdomain, :value => @subdomain %>
          <%= f.label :email, class: 'sr-only' %>
          <div class="flex">
            <%= f.text_field :email, placeholder: 'Enter an email', class: 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md' %> <br/>
            <%= f.submit :submit, class: 'cursor-pointer ml-4 flex-shrink-0 px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
          </div>
        <% end %>
      <% end %>
    </div>
    
  </div>
  <div class="mt-8 flex flex-col text-center">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Team members added to this project</h3>
    <ul role="list" class="mt-4 border-t border-b border-gray-200 divide-y divide-gray-200">
      <li class="py-4 flex items-center justify-between space-x-3">
        <div class="min-w-0 flex-1 flex items-center space-x-3">
          <% @users.each do |user| %>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-900 truncate"><%= user.name %></p>
              <p class="text-sm font-medium text-gray-500 truncate"><%= user.email %></p>
              <p class="text-sm font-medium text-gray-900 truncate"><%= user_status(user) %></p>
            </div>
          <% end %>
        </div>
      </li>
    </ul>
  </div>
</div>

