<%= render 'users/sidebar' %></br>

<div class="container-fluid">
      <% provide(:title, 'All users') %>
      <h1>Authorized Users</h1>

      <div class="panel panel-default">
        <div class="panel-body">

          <table class="table table-striped">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
            </tbody>
              <% @users.each do |user| %>
                <tr>
                  <td style="font-size:10px"><%= user.name %></td>
                  <td style="font-size:10px"><%= user.email %></td>
                  <td style="font-size:10px"><%= user_status(user) %></td>
                </tr>
              <% end %>
          </table>

      <h3 class="extra-margin-top">Invite Users</h3>
            <% if @user.plan_id == 1 %>
                  <p> You have <span style="color:red"><%= remaining_days %> Days left </span>with your free acount! <%= link_to "Suscribe Now", edit_user_path(current_user, plan: @pro_plan.id) %> to add the rest of your team!</p>
            <% else @user.plan_id == 2 %>
                <%= form_for @invite, :url => project_invites_path do |f| %>
                  <%= f.hidden_field :user_group_id, :value => @invite.user_group_id %>

                  <div class="field form-group">
                    <%= f.label :email %>
                    <%= f.text_field :email, class: 'form-control' %>
                  </div>
                  <div class="form-group">
                    <%= f.submit :submit, class: 'btn btn-primary' %>
                  </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

