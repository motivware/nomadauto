<div class="container-fluid" style="background-color:#B22222;">
  <div class="forms" class="row">
    <% if params[:plan] == '2' %>
      <div style="height:1100px;padding-top:50px;" class="col-md-4 col-md-offset-4">
        <div style="margin:50px 50px 0px 50px;padding:20px;height:850px;" class="well well-sm" >
            <h1>Pro Account</h1>
            <p>Sign up with the pro account for only $49/month!</p>
              <%= render "pro_form" %>
          </div>
        </div>
      </div>
    <% elsif params[:plan] == '1' %>
      <div style="height:1000px;padding-top:50px;" class="col-md-4 col-md-offset-4">
        <div style="margin:50px 50px 0px 50px;padding:20px;height:600px;" class="well well-sm" >
            <h1>Basic Account</h1>
            <p>Sign up for free and get basic access!</p>
              <%= render "basic_form" %>
          </div>
        </div>
      </div> 
    <% else %>
      <div style="height:1000px;padding-top:50px;" class="col-md-4 col-md-offset-4">
        <div style="margin:50px 50px 0px 50px;padding:20px;height:600px;" class="well well-sm" >
          <div class="text-center">
            <h1>Accept Invite</h1>
            <p>We just need a few things</p>
              <%= render "invite_form" %>
          </div>
        </div>
      </div>
    <% end %> 
  </div>
</div>
