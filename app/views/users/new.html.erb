<div class="container-fluid" style="background-color:#3E666F;">
  <div class="forms" class="row">
    <% if params[:plan] == '1' %>
      <div style="height:1000px;padding-top:50px;" class="col-md-6 col-md-offset-3">
        <div style="margin:50px 50px 0px 50px;padding:20px;height:675px;" class="well well-sm" >
            <h1>Basic Account</h1>
            <p>Sign up for free and get basic access!</p>
              <%= render "basic_form" %>
          </div>
        </div>
      </div>
    <% else params[:plan] == '3' %>
      <div style="height:1000px;padding-top:50px;" class="col-md-6 col-md-offset-3">
        <div style="margin:50px 50px 0px 50px;padding:20px;height:600px;" class="well well-sm" >
          <div class="text-center">
            <h1>Accept Invite</h1>
            <p>We just need a few things</p>
              <%= render "invite_form" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
