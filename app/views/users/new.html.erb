<% @title="| Signup" %>

<div class="container-fluid">
  <div class="forms" class="row">
    <% if params[:plan] == '1' %>
      <div class="min-h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8">
        <div class="sm:mx-auto sm:w-full sm:max-w-md">
          <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">Sign up for free and get started today!</h2>
        </div>
      <%= render "basic_form" %>
    <% else params[:plan] == '3' %>
      <div class="min-h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8">
      <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <img class="mx-auto h-12 w-auto" src="https://tailwindui.com/img/logos/workflow-mark-indigo-600.svg" alt="Workflow">
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">Accept invitation and get started today!</h2>
      </div>
      <%= render "invite_form" %>
    <% end %>
  </div>
</div>
