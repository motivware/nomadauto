<%= render 'users/sidebar' %><br/>
<%= render 'shared/flashes' %>
<div class="md:pl-64 flex flex-col flex-1">
  <main class="flex-1">
    <div class="py-6">
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="sm:flex sm:items-center">
          <div class="sm:flex-auto">
          <div class="flex justify-between items-center">
            <h1 class="font-bold text-4xl">Conversations</h1>
            <%= link_to "New conversation", new_project_conversation_path(), class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
          </div>

          <%= turbo_stream_from(@project, @converstion) %>
          <div id="conversations" class="min-w-full">
            <%= render @conversation %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
