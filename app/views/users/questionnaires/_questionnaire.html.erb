<div id="<%= dom_id questionnaire %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= questionnaire.name %>
  </p>

    <%= link_to "View Responses", project_contact_questionnaire_responses_path(@project, @contact, questionnaire.id, @response), class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to "Create a new response", new_project_contact_questionnaire_response_path(@project, @contact, questionnaire.id, @response), class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this survey', edit_project_contact_questionnaire_path(@project, @contact, questionnaire.id), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
</div>
