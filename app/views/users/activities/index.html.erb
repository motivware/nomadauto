<%= render 'users/sidebar' %></br>
<div class="md:pl-64 flex flex-col flex-1">
  <main class="flex-1">
    <div class="py-6">
      <!-- This example requires Tailwind CSS v2.0+ -->
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="sm:flex sm:items-center">
          <div class="sm:flex-auto">
              <h1 class="text-xl font-semibold text-gray-900">Activity Log</h1>
              <p class="mt-2 text-sm text-gray-700">A list of all the Activities.</p>
              <br/><hr>
                <br/>
                  <div class="flow-root">
                    <ul role="list" class="-mb-8">
                    <% if Activity.exists? %>
                      <% @activities.each do |activity| %>
                        <%= div_for activity do %>
                          <li>
                            <div class="relative pb-8">
                              <div class="relative flex space-x-3">
                                <div class="flex min-w-0 flex-1 space-x-4 pt-1.5">
                                <%= render "users/activities/#{activity.trackable_type.underscore}/#{activity.action}", activity: activity %>
                                </div>
                              </div>
                            </div>
                          </li>
                        <% end %>
                      <% end %>
                    <% end%>
                    </ul>
                  </div>
              </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
