<!--
  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<!--
  This example requires updating your template:

  ```
  <html class="h-full bg-gray-50">
  <body class="h-full">
  ```
-->
<div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
  <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
    <% provide(:title, 'Sign up') %>
    <%= form_for(@user) do |f| %>
        <%= hidden_field_tag 'plan', params[:plan] %>

        <%= render 'shared/error_messages', object: f.object %>

        <div class="field form-group">
            <%= f.label :name, 'Full Name', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :name, autocomplete: "off", placeholder: "Full Name", class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>
        </div>
        <br/>
        <div class="field form-group">
            <%= f.label :email,  'Email', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :email, placeholder: "Email", class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>
        </div>
        <br/>
        <div class="field form-group">
            <%= f.label :password,  'Password', class: 'block text-sm font-medium text-gray-700'  %>
            <%= f.password_field :password, placeholder: "Password", class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>
        </div>
        <br/>
        <div class="field form-group">
            <%= f.label :password_confirmation, "Password Confirmation", class: 'block text-sm font-medium text-gray-700' %>
            <%= f.password_field :password_confirmation, placeholder: "Password Confirmation", class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>
        </div>
        <br/>
        <div class="field form-group">
            <%= f.label :subdomain, "Company Name", class: 'block text-sm font-medium text-gray-700' %>
            <div class="mt-1 flex rounded-md shadow-sm">
                <%= f.text_field :subdomain, autocomplete: "off", placeholder: "Company Name", class: 'flex-1 min-w-0 block w-full px-3 py-2 rounded-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm border-gray-300' %>
                <span class="inline-flex items-center px-3 border border-r-md border-gray-300 bg-gray-50 text-gray-500 sm:text-sm">.motivware.com</span>
            </div>
        </div>
        <br/>
        <div class="form-group">
            <%= f.submit "Create my account", class: "cursor-pointer w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
        <p class="mt-6 text-center text-md font-extrabold text-gray-900">After submitting signup form, please check your email to activate your account.</p>
        <br/><br/>
        <% end %>
      </div>
    </div>
  </div>
</div>

