<div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
  <%= form_for(@user) do |f| %>
    <%= hidden_field_tag 'plan', params[:plan] %>
    <%= render 'shared/error_messages', object: f.object %>

    <div class="space-y-4">
      <div>
        <%= f.label :name, 'Full Name', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.text_field :name, autocomplete: "off", placeholder: "Jane Smith", class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
      </div>

      <div>
        <%= f.label :email, 'Email', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.text_field :email, placeholder: "jane@company.com", class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
      </div>

      <div>
        <%= f.label :password, 'Password', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.password_field :password, placeholder: "6+ characters", class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.password_field :password_confirmation, placeholder: "Confirm password", class: 'block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
      </div>

      <div>
        <%= f.label :subdomain, "Company Name", class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <div class="flex rounded-lg shadow-sm">
          <%= f.text_field :subdomain, autocomplete: "off", placeholder: "acme", class: 'flex-1 min-w-0 block w-full py-2.5 px-4 placeholder-gray-400 border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm' %>
          <span class="inline-flex items-center px-3 border border-l-0 border-gray-300 bg-gray-50 text-gray-500 text-sm rounded-r-lg">.synthmonitor.com</span>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Create Account", class: "cursor-pointer w-full inline-flex items-center justify-center py-2.5 px-4 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition" %>
      </div>
    </div>
  <% end %>
</div>
