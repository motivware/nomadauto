<div id="sidebar-wrapper">
  <ul class="sidebar-nav" id="sidebar">
        <li class="nav-link">
          <%= link_to project_contacts_path, method: :get, class: "nav-link-text" do %>
            Contacts<span style="float:right;padding-right: 20px;margin-top:10px;" style="float:right;padding-right: 10px;margin-top:10px;" class="glyphicon glyphicon-user"></span>
          <% end %>
        </li>
        <li class="nav-link">
          <%= link_to project_tasks_path,  method: :get, class: "nav-link-text" do %>
