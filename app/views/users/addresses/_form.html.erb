  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<div class="space-y-8 divide-y divide-gray-200 sm:space-y-5">
	<div>
		<div>
			<h3 class="text-lg leading-6 font-medium text-gray-900">Address</h3>
			<p class="mt-1 max-w-2xl text-sm text-gray-500">This is an address for your athlete: <%= @contact.first_name + ' ' + @contact.last_name %>  </p>
		</div>
	<%= form_for([@contact.project, @contact, @address])  do |f| %>
	<div class="pt-8 space-y-6 sm:pt-10 sm:space-y-5">
		<div class="space-y-6 sm:space-y-5">

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :street_address, 'Street Address', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :street_address, autofocus: true, placeholder: 'Street Address', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :address_line_two, 'Address Line Two', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :address_line_two, autofocus: true, placeholder: 'Address line two', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :city, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :city, autofocus: true, placeholder: 'City', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :state, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :state, autofocus: true, placeholder: 'State', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :zipcode, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :zipcode, autofocus: true, placeholder: 'Zipcode', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="pt-5">
					<%= f.submit "Save", class: 'cursor-pointer	inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto' %>
			</div>
			<% end %>
		</div>
	</div>
</div>
