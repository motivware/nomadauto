<div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
  <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
    <%= form_for @user, :url => { :action => "update" }, html: { id: 'pro_form'} do |f| %>

      <%= hidden_field_tag 'plan', params[:plan] %>

      <%= render 'shared/error_messages', object: f.object %>

        <%= f.label :name, 'Name', class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "off", value: User.find(session[:user_id]).name, readonly: true, class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm' %>
        <br/>
        <%= f.label :email, 'Email', class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, value: User.find(session[:user_id]).email, readonly: true, class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm' %>
        <br/>
        <%= f.label :subdomain, 'Company Name', class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1 flex rounded-md shadow-sm">
            <%= f.text_field :subdomain, readonly: true, value: User.find(session[:user_id]).subdomain, autocomplete: "on", placeholder: "Motivware Web Address", class: 'form-control', id: 'special', class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>    
            <span class="inline-flex items-center px-3 border border-r-md border-gray-300 bg-gray-50 text-gray-500 sm:text-sm">.motivware.com</span>
        </div>
        <br/>
      <div class="field form-group">
        <%= label_tag :card_number, "Credit Card Number", class: "block text-sm font-medium text-gray-700"  %>
        <%= text_field_tag :card_number, nil, name: nil, placeholder: "Credit Card Number", class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>
      </div>
      <br/>
      <div class="field form-group">
        <%= label_tag :card_code, "Security Code on Card (CVV)", class: "block text-sm font-medium text-gray-700"  %>
        <%= text_field_tag :card_code, nil, name: nil, placeholder: "Security Code on Card (CVV)", class: 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'  %>
      </div>
      <br/>
      <div class="form-group">
        <%= label_tag :card_month, "Card Expiration", class: "block text-sm font-medium text-gray-700" %>
        <%= select_month nil,  {add_month_numbers: true}, {name: nil, id: "card_month" } %>
        <%= select_year nil, {start_year: Date.today.year, end_year: Date.today.year+15}, {name: nil, id: "card_year" } %>
      </div>
      <br/>
      <div class="form-group">
        <%= f.submit "Sign up", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500", id: 'form-submit-btn' %>
      </div>
      </br>
    <% end %>
  </div>
</div>
