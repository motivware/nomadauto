<!--
  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<div class="space-y-8 divide-y divide-gray-200 sm:space-y-5">
	<div>
		<div>
			<h3 class="text-lg leading-6 font-medium text-gray-900">Contact</h3>
			<p class="mt-1 max-w-2xl text-sm text-gray-500">This information will be displayed for you and your team to reference.</p>
		</div>
	<%= form_for([@contact.project, @contact])  do |f| %>
	<div class="pt-8 space-y-6 sm:pt-10 sm:space-y-5">
		<div class="space-y-6 sm:space-y-5">
			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :company, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :company, autofocus: true, placeholder: 'Company', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :first_name, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :first_name, autofocus: true, placeholder: 'First Name', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :last_name, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :last_name, autofocus: true, placeholder: 'Last Name', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">	
				<%= f.label :phone_number, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :phone_number, autofocus: true, placeholder: 'Phone Number', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :emai, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :email, autofocus: true, placeholder: 'Email Address', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :website, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :website, autofocus: true, placeholder: 'Website', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>     
			<div class="pt-5">
					<%= f.submit "Save", class: 'cursor-pointer	inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto' %>
			</div>
			<% end %>
		</div>
	</div>
</div>
<%#       
<td><%= link_to "Delete", [@contact.project, @contact, @activities], method: :delete, data: { confirm: "Are you sure?" } %><%# </td>
<td><%= link_to "Back", project_contacts_path(@project) %>

