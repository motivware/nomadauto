  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<div class="space-y-8 divide-y divide-gray-200 sm:space-y-5">
	<div>
		<div>
			<h3 class="text-lg leading-6 font-medium text-gray-900">Contact</h3>
			<p class="mt-1 max-w-2xl text-sm text-gray-500">This information will be displayed for you and your team to reference.</p>
		</div>
	<%= form_for([@contact.project, @contact])  do |f| %>
	<div class="pt-8 space-y-6 sm:pt-10 sm:space-y-5">
		<div class="space-y-6 sm:space-y-5">
			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :first_name, 'First Name', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :first_name, autofocus: true, placeholder: 'First Name', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :last_name, 'Last Name', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :last_name, autofocus: true, placeholder: 'Last Name', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">	
				<%= f.label :phone_number, 'Phone Number', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :phone_number, autofocus: true, placeholder: 'Phone Number', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :emai, 'Email Address', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.text_field :email, autofocus: true, placeholder: 'Email Address', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>   
			
			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">	
				<%= f.label :status, class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
					<% if @contact.new_record? %>
						<%= f.select :status, options_for_select([['Lead'],['Prospect'],['Current Customer'],['Completed']]), { include_blank: 'Select status' }, class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
					<% else %>
						<%= f.select :status, options_for_select([['Lead'],['Prospect'],['Customer'],['Completed']], @contact.status), { include_blank: 'Select status' }, class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
					<% end %>
			</div> 

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :start_date, 'Start Date', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.date_field :start_date, autofocus: true, placeholder: 'Start Date', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div> 

			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :end_date, 'End Date', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.date_field :end_date, autofocus: true, placeholder: 'End Date', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div>   
			
			<div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :pay_rate, 'Pay Rate', class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<%= f.number_field :pay_rate, autofocus: true, placeholder: 'Pay Rate', class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>	
			</div> 

			<div class="sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :attachment, "Upload Attachment", class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
        <%= f.file_field :attachment, class: 'max-w-lg block w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:max-w-xs sm:text-sm border-gray-300 rounded-md' %>
			</div> 

			<div class="sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
				<%= f.label :comment, "Comments", class: 'block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2' %>
				<br/>
				<%= f.text_area :comment, autofocus: true, placeholder: 'Comments', class: 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md' %>	
			</div> 
			
			<%= f.hidden_field :user_id, value: current_user.id, readonly: true, class: 'form-control' %>
			
			<div class="pt-5">
					<%= f.submit "Save", class: 'cursor-pointer	inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto' %>
			</div>
			<% end %>
		</div>
	</div>
</div>
<%#       
<td><%= link_to "Delete", [@contact.project, @contact, @activities], method: :delete, data: { confirm: "Are you sure?" } %><%# </td>
<td><%= link_to "Back", project_contacts_path(@project) %>

