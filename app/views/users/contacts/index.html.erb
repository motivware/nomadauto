<%= render 'users/sidebar' %></br>

<div class="container-fluid">
  <div class="col-md-16 col-md-offset-0">
    <%= link_to "Add New Contact", new_project_contact_path, :class => "btn btn-default" %></br></br>
  </div>
  <div class="table-responsive">
    <table class="table">
      <tr>
          <th>Company</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Phone Number</th>
          <th>Website</th>
          <th>Email</th>
          <th></th>
          <th></th>
      </tr>
      <%if Contact.exists? %>
        <% @contacts.each do |contact| %>
            <tr>
              <td><%= link_to contact.company %></td>
              <td><%= link_to contact.first_name, edit_project_contact_path(@project, contact)  %></td>
              <td><%= contact.last_name %></td>
              <td><%= contact.phone_number %></td>
              <td><%= contact.website %></td>
              <td><%= contact.email %></td>
            </tr>
        <% end %>
      <% end %>
    </table>
    <%= form_tag import_project_contacts_path do %>
      <%= file_field_tag :file %>
      <%= submit_tag "Upload" %>
    <% end %>
  </div>
</div>
