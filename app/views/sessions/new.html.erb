<div class="container-fluid" style="background-color:#B22222;">
  <div class="forms" class="row">
    <div style="height:900px;" class="col-md-4 col-md-offset-4">
      <div style="margin:250px 50px 0px 50px;padding:20px;height:400px;" class="well well-sm" >

      <h1>Log in</h1>

      <% provide(:title, "Log in") %>
      

          <%= form_for(:session, url: login_path) do |f| %>

            <%= f.label :email %>
            <%= f.text_field :email, placeholder: "Email", class: 'form-control' %>

            <%= f.label :password %>
            <%= link_to "(forgot password)", new_password_reset_path %>
            <%= f.password_field :password, placeholder: "Password", class: 'form-control' %>

            <%= f.label :remember_me, class: "checkbox inline" do %>
              <%= f.check_box :remember_me %>
              <span>Remember me on this computer</span>
            <% end %>

            <%= f.submit "Log in", class: "btn btn-default" %>
          <% end %>

          <p>New user? <%= link_to "Sign up now!", signup_path(plan: @basic_plan.id) %></p>
      </div>
    </div>
  </div>
</div>
