<!-- This example requires Tailwind CSS v2.0+ -->
<div class="min-h-full flex flex-col justify-center py-12 md:px-6 lg:px-8">
  <div class="md:mx-auto md:w-full sm:max-w-md">
    <div class="text-center">
      <svg class="mx-auto h-20 w-20 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
      </svg>
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">Motivware</h2>
      <% if @user.plan_id == 1 %>
        <p class="mt-5 text-xl text-gray-500">Get started by creating a new project.</p>  
        <p class='mt-1 text-sm text-gray-500'> Trial period will expire in <span style="color:red"><%= remaining_days %> Days. </span><br/><%= link_to "Suscribe Now!", edit_user_path(current_user, plan: @pro_plan.id) %></p>
      <% end %>
      <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
          <% @projects.each do |project| %>
          <div class="flex justify-center">
            <ul role="list" class="mt-4 grid">
              <li class="col-span-1 shadow-sm rounded-md hover:gray-800">
                <div class="flex-1 justify-between border border-gray-200 bg-white rounded truncate">
                  <div class="flex-1 px-4 py-2 text-sm truncate">
                    <%= link_to project.title, project_contacts_path(project), class: 'text-gray-900 font-large hover:text-gray-600' %>
                    <p class="text-gray-500"><%= project.details %></p>
                  </div>
                </div>
              </li>
            </ul>
          </div>
          <% end %>
        <br/>          
          <% if @user.plan_id == 1 || @user.plan_id == 2  %>
            <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            <h2><%= link_to 'Create New Project', new_project_path %></h2>
          <% end %>
        </button>
      </div>
      </div>
      </div>
    </div>
  </div>
</div>