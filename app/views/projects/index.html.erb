<div class="max-w-4xl mx-auto px-4 py-12">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900">Your Projects</h1>
    <% if @user.plan_id == 1 %>
      <p class="mt-2 text-sm text-gray-500">
        Trial expires in <span class="text-red-600 font-medium"><%= remaining_days %> days</span>.
        <%= link_to "Subscribe Now!", edit_user_path(current_user, plan: @pro_plan.id), class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
      </p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
    <% @projects.each do |project| %>
      <%= link_to project_monitors_path(project), class: "block bg-white shadow-sm rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow" do %>
        <h2 class="text-lg font-semibold text-gray-900"><%= project.title %></h2>
        <% if project.details.present? %>
          <p class="mt-1 text-sm text-gray-500"><%= project.details %></p>
        <% end %>
        <p class="mt-3 text-sm text-gray-400"><%= project.site_monitors.size %> monitors</p>
      <% end %>
    <% end %>
  </div>

  <% if @user.plan_id == 1 || @user.plan_id == 2 %>
    <div class="text-center">
      <%= link_to new_project_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" do %>
        <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        Create New Project
      <% end %>
    </div>
  <% end %>
</div>
