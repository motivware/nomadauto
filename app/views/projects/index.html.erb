<div class="container-fluid" style="background-color:#B22222;">
  <div class="forms" class="row">
    <div style="height:900px;" class="col-md-6 col-md-offset-3">
      <div style="margin:200px 50px 0px 50px;padding:20px;height:400px;" class="well well-sm" >
      <h1>Teams</h1>
      <div class="well">
      <% if @user.plan_id == 1 %>
        <p> Trial period will expire in <span style="color:red"><%= remaining_days %> Days. </span></br><%= link_to "Suscribe Now!", edit_user_path(current_user, plan: @pro_plan.id) %></p>
      <% end %>
      <% if @user.plan_id == 1 || @user.plan_id == 2  %>
        <h2><%= link_to 'Create New Team', new_project_path, class: 'btn btn-default btn-lg' %></h2>
      <% end %>
        <table class="table table-striped">
          <% current_account.projects.each do |project| %>
            <tr>
              <td><%= link_to project.title, project_workorders_path(project) %></td>
              <td><%= project.details %></td>
            </tr>
          <% end %>
        </table>
      </div>
    </div>
  </div>
</div>
