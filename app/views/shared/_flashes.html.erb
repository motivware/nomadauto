<% flash.each do |type, msg| %>
<div class="md:pl-64 flex flex-col flex-1" style="place-items: center;position: absolute;width: 1500px;">
	<% if type == 'success' %>
	<div id="alert-success" class="flex bg-white flex-row shadow-md border border-gray-100 rounded-lg overflow-hidden md:w-5/12">
    <div class="flex w-3 bg-gradient-to-t from-green-500 to-green-400"></div>
    <div class="flex-1 p-3">
      <h1 class="md:text-xl text-gray-600">Success</h1>
      <p class="text-gray-400 text-xs md:text-sm font-light"><%= msg %></p>
    </div>
     <div class="cursor-pointer border-l hover:bg-gray-50 border-gray-100 px-4 flex place-items-center" data-dismiss-target="#alert-success">
      <p class="text-gray-400 text-xs">Close</p>
    </div>
  </div>
	<% elsif type == 'notice' %>
  <div id="alert-notice" class="flex bg-white flex-row shadow-md border border-gray-100 rounded-lg overflow-hidden md:w-5/12">
    <div class="flex w-3 bg-gradient-to-t from-blue-500 to-blue-400"></div>
    <div class="flex-1 p-3">
      <h1 class="md:text-xl text-gray-600">Notice</h1>
      <p class="text-gray-400 text-xs md:text-sm font-light"><%= msg %></p>
    </div>
    <div class="cursor-pointer border-l hover:bg-gray-50 border-gray-100 px-4 flex place-items-center" data-dismiss-target="#alert-notice">
      <p class="text-gray-400 text-xs">Close</p>
    </div>
  </div>
	<% else type == 'warning' %>
  <div id="alert-warning" class="flex bg-white flex-row shadow-md border border-gray-100 rounded-lg overflow-hidden md:w-5/12">
    <div class="flex w-3 bg-gradient-to-t from-yellow-500 to-yellow-300"></div>
    <div class="flex-1 p-3">
      <h1 class="md:text-xl text-gray-600">Warning</h1>
      <p class="text-gray-400 text-xs md:text-sm font-light"><%= msg %>/p>
    </div>
    <div class="cursor-pointer border-l hover:bg-gray-50 border-gray-100 px-4 flex place-items-center" data-dismiss-target="#alert-warning">
      <p class="text-gray-400 text-xs">Close</p>
    </div>
  </div>
	<% end %>
	</div>
<% end %>
