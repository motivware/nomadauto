<!DOCTYPE html>
<html lang = "en">
  <head>
    <title>SynthMonitor <%= @title %></title>
    <%= csrf_meta_tags %>
    <meta name="Description" content="Synthetic user monitoring for critical path automation testing.">
    <meta name=viewport content="width=device-width, initial-scale=1, user-scalable=0">
    <meta name="HandheldFriendly" content="true">
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <%= favicon_link_tag asset_path('favicon.svg') %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= javascript_include_tag "https://www.google.com/jsapi", "chartkick" %>
    <%= javascript_include_tag "https://code.highcharts.com/highcharts.js", type: 'application/javascript' %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex flex-col min-h-screen">

  <%= render 'layouts/header' %>

  <main class="flex-grow">
    <%= yield %>
  </main>

  <% unless logged_in? && request.subdomain.present? %>
    <%= render 'layouts/footer' %>
  <% end %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.5/flowbite.min.js"></script>

  <!-- Global site tag (gtag.js) - Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-105637220-2"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'UA-105637220-2');
    gtag('config', 'AW-947127677');
  </script>
  </body>
</html>
