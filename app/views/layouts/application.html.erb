<!DOCTYPE html>
<html lang = "en">
  <head>
    <title>Motivware | Technical Support Software</title>
    <%= csrf_meta_tags %>
    <meta name="Description" content="Motivware is a web-based customer support software application.">
    <meta name=viewport content="width=device-width, initial-scale=1, user-scalable=0">
    <meta name="HandheldFriendly" content="true">
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <%= favicon_link_tag asset_path('favicon.svg') %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag "https://js.stripe.com/v2/", type: 'text/javascript' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag "https://www.google.com/jsapi", "chartkick" %>
    <%= javascript_include_tag "https://code.highcharts.com/highcharts.js", type: 'application/javascript' %>
    <!-- Global site tag (gtag.js) - Google Ads: 947127677 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-947127677"></script>
    <%= tag :meta, :name => "stripe-key", :content => STRIPE_PUBLIC_KEY %>
  </head>
  <body>

  <% flash.each do |type, msg| %>
      <%= content_tag :div, msg, class: "alert alert-#{type}" %>
  <% end %>
  
  <% if not logged_in? && request.subdomain.present? %>
    <%= render 'layouts/header' %>
  <% end %>

  <%= yield %>

  <% if not logged_in? && request.subdomain.present? %>
    <%= render 'layouts/footer' %>
  <% end %>
  <!-- Global site tag (gtag.js) - Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-105637220-2"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'UA-105637220-2');
    gtag('config', 'AW-947127677');
  </script>
  </body>
</html>
