<!-- This example requires Tailwind CSS v2.0+ -->
<nav class="bg-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center">
        <div class="hidden sm:block sm:ml-6">
          <div class="flex-shrink-0">
          <% p request.subdomain %>
           <% if current_user.nil? && request.subdomain.present? && request.subdomain != "https://www" %>
              <% if current_page?(new_project_ticket_path) || current_page?(project_articles_path) %>
                <%= link_to image_tag('logo_alt.svg'), root_url(subdomain: false) %>
              <% end %>
          <% else %>
              <%= link_to image_tag('logo_alt.svg'), root_url %>
          <% end %>
          </div>
        </div>
        <div class="hidden sm:block sm:ml-6">
          <div class="flex space-x-4">
          <% subdomains = %w[https:// www admin] %>
             <!-- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white" -->
            <% if logged_in? && request.subdomain.blank? %>
              <a><%= link_to "Projects", projects_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "My Account", edit_user_path(current_user), class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "Log Out", logout_path, method: :delete, class: 'text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium' %></a>
            <% elsif current_user.nil? && request.subdomain.present? && request.subdomain != "https://www" %>
              <% if current_page?(new_project_ticket_path) || current_page?(project_articles_path) %>
              <a><%= link_to "Support", project_articles_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <% end %>
            <% else %>
              <!-- <li><%= link_to features_path%></li> -->
              <a><%= link_to "Pricing", pricing_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "Contact", new_contact_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "Log In", login_path, class: 'text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium' %></a>
              <a href="https://nomad.motivware.com/projects/3/articles" class="text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium">Help Center</a>
            <% end %>
          </div>
        </div>
      
        <div class="sm:hidden sm:ml-6">
          <div class="flex-shrink-0">
            <%= link_to image_tag('logo_alt.svg', width: '100'), root_url %>
          </div>
        </div>
      <div class="sm:hidden" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1">
          <!-- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white" -->
           <% if logged_in? && request.subdomain.present? %>
              <a><%= link_to "Projects", projects_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "My Account", edit_user_path(current_user), class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "Log Out", logout_path, method: :delete, class: 'text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium' %></a>
            <% elsif current_user.nil? && request.subdomain.present? %>
              <% if current_page?(new_project_ticket_path) || current_page?(project_articles_path) %>
              <a><%= link_to "Support", project_articles_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <% end %>
            <% else %>
              <!-- <li><%= link_to features_path%></li> -->
              <a><%= link_to "Pricing", pricing_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "Contact", new_contact_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %></a>
              <a><%= link_to "Log In", login_path, class: 'text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium' %></a>
              <a href="https://nomad.motivware.com/projects/3/articles" class="text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium">Help Center</a>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>
