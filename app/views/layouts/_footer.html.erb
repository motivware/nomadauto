<footer class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto py-12 px-4 overflow-hidden sm:px-6 lg:px-8">
  <% unless current_user.nil? && request.subdomain.present? && request.subdomain != "www" %>
    <nav class="-mx-5 -my-2 flex flex-wrap justify-center" aria-label="Footer">
      <div class="px-5 py-2">
<%= link_to "FAQ", root_path(anchor: "faq"), class: "text-sm text-gray-500 hover:text-gray-900 transition" %>
      </div>
      <div class="px-5 py-2">
        <%= link_to "Privacy Policy", privacy_path, class: "text-sm text-gray-500 hover:text-gray-900 transition" %>
      </div>
      <div class="px-5 py-2">
        <%= link_to "Terms of Use", terms_path, class: "text-sm text-gray-500 hover:text-gray-900 transition" %>
      </div>
    </nav>
  <% end %>
    <p class="mt-8 text-center text-sm text-gray-400">&copy; <%= Date.today.year %> SynthMonitor. All Rights Reserved.</p>
  </div>
</footer>
