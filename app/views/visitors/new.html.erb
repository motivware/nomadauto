<div class="container-fluid" id="News">
  <div class="row">
    <div class="col-md-8 col-sm-8 col-md-offset-2"><br/>
      <h2 style="font-size: 3.8em; padding-top:50px; font-weight:bold;">Make your autoshop management <br>easier than ever.</h2>
      <h3 class="sm-none" style="font-size: 2.3em; padding-bottom:20px;text-align:left;padding-left:100px;font-weight:bold;">
      Software that is simple to use <br>
      <br> Only takes seconds to setup <br>
      <br> Will help your business grow</h3>
        <ul style="padding-top:50px;list-style-type:none;text-align:left;">
          <li style="padding-right:10px;margin-top:25px;">
          <%= link_to "Request a Demo", new_contact_path, class: 'btn btn-default btn-lg' %>
          </li>
          <br/>
        </ul>
    </div>
  </div>
</div>


<div style="background-color:#F1F2F4" class="container-fluid">

  <div class="row">




    <section class="featurewrapper">
        <div class="cardwrapper">
          <%= image_tag 'clipboard.svg', :class => "image" %>
          <h2 class="cardheading">Work Orders</h2>
          <p class="body">Assign tasks and keep
              your team organized. Track
              what is completed and what
              still needs done.</p>
        </div>
  
        <div class="cardwrapper">
          <%= image_tag 'road.svg', :class => "image" %>
          <h2 class="cardheading">Vehicle Roadmap</h2>
          <p class="body">Keep track of all your vehicles and 
          alert customers of common vehicle problems.</p>
        </div>


        <div class="cardwrapper">
          <%= image_tag 'invoice.svg', :class => "image" %>
          <h2 class="cardheading">Invoice Generation</h2>
          <p class="body">Generate invoices and contain a history
              of records. Customize your
              invoice to suite your needs.</p>
        </div>

        <div class="cardwrapper">
          <%= image_tag 'search.svg', :class => "image" %>
          <h2 class="cardheading">Part Finder</h2>
          <p class="body">Search for parts across
              the web. Ensure your finding the right 
              part for the job.</p>
        </div>

        <div class="cardwrapper">
          <%= image_tag 'calculator.svg', :class => "image" %>
          <h2 class="cardheading">Repair Estimates</h2>
          <p class="body">Build service repair estimates for your customers. 
              Send the estimates by print or email.</p>
        </div>

         <div class="cardwrapper">
          <%= image_tag 'mobile.svg', :class => "image" %>
          <h2 class="cardheading">Mobile Friendly</h2>
          <p class="body">Use with your phone or tablet from
              anywhere with Wifi. Stay up to date
              with all work being done from home.</p>
        </div>

        <div class="cardwrapper">
          <%= image_tag 'mobile.svg', :class => "image" %>
          <h2 class="cardheading">Customer Portal</h2>
          <p class="body">Allow customers to submit service requests and
              view the status of their vehicles. </p>
        </div>

        <div class="cardwrapper">
          <%= image_tag 'database.svg', :class => "image" %>
          <h2 class="cardheading">Database Normalization</h2>
          <p class="body">Start keeping your records organized.
              Save a history of everything your shop
              has been working on. </p>
        </div>
        
    </section>

  </div>
</div>

<section class="ctawrapper">
  <div class="cta">
    <h2 class="heading">Ready to Manage Your Autoshop Business?</h2>
    <%= link_to "Try for Free", signup_path(plan: @basic_plan.id), class: 'button' %>
  </div>
</section>

<footer class="wrapper">
  <div class="inner">
    <div class="newsletter">
      <h3 class="newsletterHeading">NEWSLETTER</h3>

      <p class="newsletterBody">
        To recieve tips on how to use motivware and grow your business, sign up to our weekly
        newsletter. We’ll never send you spam or pass on your email address.
      </p>

      <form >
          <%= form_for @visitor do |f| %>
            <%= f.text_field :email, label: false, :placeholder => 'Your email address...', class: 'formEmail' %>
            <br/><br/>
            <%= f.submit "Subscribe", :class => "formButton" %>
          <% end %>
      </form>
    </div>

    <div class="about">
      <img class="logo" />
      <%= image_tag 'logo_alt.svg' %>

      <p class="aboutBody">
        Motivware is an all-in-one tool for your autoshop business designed to
        assist auto-mechanic repair shops with customer relationships and
        business processes.
      </p>

      <ul class="info">
        <li class="infoItem">
          <%= image_tag 'mail.svg', :class => "infoItemLogo" %>
          <a class="emailLink" href="mailto:support@motivware.com" >
            support@motivware.com
          </a>
        </li>
      </ul>
    </div>
  </div>

  <ul class="links">
    <li class="linkItem">
      <a  href="#"><%= link_to "FAQ", faq_path, :class => "link" %></a>
    </li>
    <li class="linkItem">
      <a class="link" href="#">Privacy Policy</a>
    </li>
    <li class="linkItem">
      <a class="link" href="#">Terms of Use</a>
    </li>
  </ul>

  <p class="copyright">
    Copyright © Motivware 2019. All Rights Reserved
  </p>
</footer>