<% @title="| Technical Support Software" %>

<%= render 'shared/flashes' %>
<!-- This example requires Tailwind CSS v2.0+ -->
<div class="relative bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="z-10 pb-8 bg-white sm:pb-16 md:pb-20 lg:max-w-2xl lg:w-full lg:pb-28 xl:pb-32">
      <svg class="hidden lg:block absolute right-0 inset-y-0 h-full w-48 text-white transform translate-x-1/2" fill="currentColor" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="50,0 100,0 50,100 0,100" />
      </svg>

      <div>
        <div class="relative pt-6 px-4 sm:px-6 lg:px-8">
          
        </div>
        <div class="absolute z-10 top-0 inset-x-0 p-2 transition transform origin-top-right md:hidden">
          
        </div>
      </div>

      <main class="mt-10 mx-auto max-w-7xl px-4 sm:mt-12 sm:px-6 md:mt-16 lg:mt-20 lg:px-8 xl:mt-28">
        <div class="sm:text-center lg:text-left">
          <h1 class="text-2xl tracking-tight font-extrabold text-gray-900 sm:text-3xl md:text-4xl">
            <span class="block xl:inline">Transform Your Workflow, Simplify Customer Support, and Boost Productivity with Motivware.</span>
          </h1>
          <p class="mt-3 text-base text-gray-500 sm:mt-5 sm:text-lg sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0">A comprehensive web-based application that integrates ticket, contact, and task management into a one platform. With built-in activity tracking and a robust knowledge base, Motivware empowers you to streamline your workflow, enhance collaboration, and boost productivity like never before.</p>
          <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start">
            <div class="rounded-md shadow">
              <%= link_to "Start Free Trial", signup_path(plan: @basic_plan.id),
                                        class: 'w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 md:py-4 md:text-lg md:px-10' %>
            </div>
            <div class="mt-3 sm:mt-0 sm:ml-3">
              <%= link_to "Book a Demo", new_contact_path, class: 'w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 md:py-4 md:text-lg md:px-10' %>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <div class="lg:absolute lg:inset-y-0 lg:right-0">
    <img class="h-56 w-full object-cover sm:h-72 md:h-96 lg:w-full lg:h-full" src="/assets/hero.svg" alt="">
  </div>
</div>

<div class="overflow-hidden bg-gray-50 py-16 lg:py-12">
  <div class="relative mx-auto max-w-xl px-6 lg:max-w-7xl lg:px-8">
    <div class="relative">
      <h2 class="text-center text-3xl font-bold leading-8 tracking-tight text-gray-900 sm:text-4xl">Embark on Your Journey Today <br/>Sign Up and Empower Your Team!</h2>
    </div>
    <br/><br/>
    <img src="/assets/ticket_list_hero.png" alt="">
  </div>
</div>
<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mt-20 max-w-lg sm:mx-auto md:max-w-none">
      <div class="grid grid-cols-1 gap-y-16 md:grid-cols-2 md:gap-x-12 md:gap-y-16">
        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <h3 class="text-lg font-semibold leading-8 text-gray-900">Simplified Support: Experience Omnichannel Ticketing</h3>
            <p class="mt-2 text-base leading-7 text-gray-600">In the dynamic world of customer support, effective communication is key. With Motivware's cutting-edge Omnichannel Ticketing, you can effortlessly handle conversations from multiple channels, including email and phone calls, all within a unified help desk platform.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <h3 class="text-lg font-semibold leading-8 text-gray-900">Efficiently Manage Ticket Priorities: Set and Filter by Priority</h3>
            <p class="mt-2 text-base leading-7 text-gray-600">No more guesswork or confusion about which tickets require immediate attention. Motivware empowers you to set priority levels for every ticket, whether it's high, medium, or low. This allows you to establish a clear hierarchy, ensuring that critical issues are resolved without delay.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Effortlessly Track Ticket Status: Organize and Categorize Tickets</p>
            <p class="mt-2 text-base leading-7 text-gray-600">Gone are the days of sifting through a pile of unorganized tickets. Motivware allows you to effortlessly classify tickets into logical categories based on their status. Whether it's "Open," "In Progress," "Pending," or "Resolved," you can quickly identify the status of each ticket at a glance, streamlining your support workflow.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Empower Users Self-Service: Knowledge Base and Ticket Creation</p>
            <p class="mt-2 text-base leading-7 text-gray-600">By leveraging the power of the Customer Portal, you provide your customers with the tools they need to find solutions and access support effortlessly. Elevate your customer experience and empower your users to take control of their support journey with Motivware's self-service knowledge base and convenient ticket creation.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Conveniently Track Contacts: Streamline Your Customer Process</p>
            <p class="mt-2 text-base leading-7 text-gray-600">With Motivware, you can optimize your customer management process and boost team efficiency. Start by adding your customer contacts, and unlock the power of effortless task management to keep your team organized and productive.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Collaborate with Multiple Users: Teamwork and Productivity</p>
            <p class="mt-2 text-base leading-7 text-gray-600">At Motivware, we understand the power of teamwork and collaboration. That's why our platform allows you to invite your team members and work together effortlessly, fostering a harmonious and productive environment.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>


<!--
  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->
<div class="bg-white">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:py-16 lg:px-8">
    <div class="px-6 py-6 bg-indigo-700 rounded-lg md:py-12 md:px-12 lg:py-16 lg:px-16 xl:flex xl:items-center">
      <div class="xl:w-0 xl:flex-1">
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Want product news and updates?</h2>
        <p class="mt-3 max-w-3xl text-lg leading-6 text-indigo-200">Sign up for our newsletter to stay up to date.</p>
      </div>
      <div class="mt-8 sm:w-full sm:max-w-md xl:mt-0 xl:ml-8">
        <%= form_for @visitor, class: "sm:flex" do |f| %>
          <%= f.text_field :email, label: false, :placeholder => 'Your email address...', class: 'w-full border-white px-5 py-3 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-indigo-700 focus:ring-white rounded-md' %>
          <br/><br/>
          <%= f.submit "Notify me", :class => "cursor-pointer mt-3 w-full flex items-center justify-center px-5 py-3 border border-transparent shadow text-base font-medium rounded-md text-white bg-indigo-500 hover:bg-indigo-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-indigo-700 focus:ring-white sm:mt-0 sm:ml-3 sm:w-auto sm:flex-shrink-0" %>
        <% end %>
        <p class="mt-3 text-sm text-indigo-200">
          We care about the protection of your data. Read our
          <a href="#" class="text-white font-medium underline"> Privacy Policy. </a>
        </p>
      </div>
    </div>
  </div>
</div>