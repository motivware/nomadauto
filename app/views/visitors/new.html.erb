<% @title="| CRM Software for Small Businesses and Startups" %>

<%= render 'shared/flashes' %>
<!-- This example requires Tailwind CSS v2.0+ -->
<div class="relative bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="z-10 pb-8 bg-white sm:pb-16 md:pb-20 lg:max-w-1xl lg:w-full lg:pb-28 xl:pb-32">
      <svg class="hidden lg:block absolute right-0 inset-y-0 h-full w-48 text-white transform translate-x-1/2" fill="currentColor" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="50,0 100,0 50,100 0,100" />
      </svg>

      <main class="mt-10 mx-auto max-w-7xl px-4 sm:mt-12 sm:px-6 md:mt-16 lg:mt-20 lg:px-8 xl:mt-28">
        <div class="sm:text-center lg:text-center">
          <h1 class="tracking-tight font-extrabold text-gray-900 text-2xl sm:text-5xl md:text-6xl">
            <span class="block xl:inline">Boost Your Team's Mojo <br/> with Our Groovy CRM!</span>
          </h1>
          <p class="mt-4 text-base text-gray-500 sm:mt-5 sm:text-lg sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-4">Attention small business owners and startups! 🚀 Introducing Motivware, your CRM partner in success! Our prototype seamlessly integrates customer support and sales functionalities, providing a unified solution for streamlined operations.
             But we're not done yet! We're cooking up improvements based on your feedback to make Motivware even better. 
           <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-center">

            <div class="rounded-md shadow">
              <%= link_to "Try for Free Today", signup_path(plan: @basic_plan.id),
                                        class: 'w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 md:py-4 md:text-lg md:px-10' %>
            </div>
            <div class="mt-3 sm:mt-0 sm:ml-3">
              <%= link_to "Book a Demo", 'https://calendly.com/motivware/discovery-call', class: 'w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 md:py-4 md:text-lg md:px-10' %>
            </div>
          </div>
        </div>
        <div class="flex justify-center mt-10">
          <video class="object-cover w-full h-96 rounded-xl lg:w-4/5" controls>
            <source src="/assets/contact_and_tickets_landing.mp4" />
          </video>
        </div>
      </main>
      
    </div>
  </div>
</div>

<div class="overflow-hidden bg-gray-50 py-16 lg:py-12">
  <div class="relative mx-auto max-w-xl px-6 lg:max-w-7xl lg:px-8">
    <div class="relative">
      <h2 class="text-center text-xl font-bold leading-8 tracking-tight text-gray-900 sm:text-4xl">
        <%# Our new CRM streamlines team workflows, replacing messy spreadsheets and overloaded CRM systems for simplicity and efficiency. %>
        Unlock exclusive access to our app during its MVP pre-beta phase <br/> no cost, no strings attached!👫🆓
        </h2>
    </div>
  </div>
</div>

<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mt-20 max-w-lg sm:mx-auto md:max-w-none">
      <div class="grid grid-cols-1 gap-y-16 md:grid-cols-2 md:gap-x-12 md:gap-y-16">
        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <h3 class="text-lg font-semibold leading-8 text-gray-900">Start by Adding Contacts 🚀</h3>
            <p class="mt-2 text-base leading-7 text-gray-600">Staying connected to your contacts is a big deal. 😅 Check out Motivware—it's still evolving, but it's a fantastic starting point for keeping your team organized.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Create Tailored Surveys for Clients. Gain Insights!</p>
            <p class="mt-2 text-base leading-7 text-gray-600">Empower your approach with our tool to craft personalized surveys for your clients. Tailor your questions to gain valuable insights, enabling you to provide highly individualized support.</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">  
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-xl font-semibold leading-8 text-gray-900">Take Control with Our Ticketing System!</p>
            <p class="mt-2 text-base leading-7 text-gray-600">Step right up to our ticketing system: Filter support tickets with ease and keep your team organized. Enjoy omni-channel support!</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Empower Your Team with a Knowledge Base! 📝</p>
            <p class="mt-2 text-base leading-7 text-gray-600"> Unlock a customer-facing knowledge base: Let users help themselves! Discover seamless organization and boost team productivity.</p>
          </div>
        </div>
        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">  
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-xl font-semibold leading-8 text-gray-900">Team Collaboration Invite Multiple Users!</p>
            <p class="mt-2 text-base leading-7 text-gray-600">At Motivware, we're all about teamwork and making things flow smoothly. Let's create that awesome work vibe together!</p>
          </div>
        </div>

        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
          <div class="sm:min-w-0 sm:flex-1">
            <p class="text-lg font-semibold leading-8 text-gray-900">Elevate Your business with Contact Profiles! 📝</p>
            <p class="mt-2 text-base leading-7 text-gray-600"> Enhance your business with our centralized profiles and note-taking service. Give it a try today and be part of our ongoing improvement journey!</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<!--
  This example requires Tailwind CSS v2.0+ 
  
  This example requires some changes to your config:
  
  ```
  // tailwind.config.js
  module.exports = {
    // ...
    plugins: [
      // ...
      require('@tailwindcss/forms'),
    ],
  }
  ```
-->


<div class="bg-white">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:py-16 lg:px-8">
    <div class="px-6 py-6 bg-indigo-700 rounded-lg md:py-12 md:px-12 lg:py-16 lg:px-16 xl:flex xl:items-center">
      <div class="xl:w-0 xl:flex-1">
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Wanna stay in the know?</h2>
        <p class="mt-3 max-w-3xl text-lg leading-6 text-indigo-200">Join our newsletter crew!</p>
      </div>
      <div class="mt-8 sm:w-full sm:max-w-md xl:mt-0 xl:ml-8">
        <%= form_for @visitor, class: "sm:flex" do |f| %>
          <%= f.text_field :email, label: false, :placeholder => 'Your email address...', class: 'w-full border-white px-5 py-3 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-indigo-700 focus:ring-white rounded-md' %>
          <br/><br/>
          <%= f.submit "Notify me", :class => "cursor-pointer mt-3 w-full flex items-center justify-center px-5 py-3 border border-transparent shadow text-base font-medium rounded-md text-white bg-indigo-500 hover:bg-indigo-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-indigo-700 focus:ring-white sm:mt-0 sm:ml-3 sm:w-auto sm:flex-shrink-0" %>
        <% end %>
        <p class="mt-3 text-sm text-indigo-200">
          We've got your data covered. Check our
          <a href="#" class="text-white font-medium underline"> Privacy Policy. </a>
        </p>
      </div>
    </div>
  </div>
</div>