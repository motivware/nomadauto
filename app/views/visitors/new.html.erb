<% @title="| Synthetic User Monitoring" %>

<%= render 'shared/flashes' %>

<!-- Hero Section -->
<div class="bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-4xl mx-auto px-4 py-24 sm:py-32 text-center">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-gray-900 leading-tight">
      Synthetic Monitoring<br class="hidden sm:inline" /> for Critical Paths
    </h1>
    <p class="mt-6 max-w-2xl mx-auto text-lg sm:text-xl text-gray-500 leading-relaxed">
      Run automated browser tests against your production app on a schedule. Get alerted the moment a critical user flow breaks.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <%= link_to "Start Free Trial", signup_path(plan: @basic_plan.id),
            class: "inline-flex items-center justify-center px-8 py-3 text-base font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition" %>
      <a href="#features" class="inline-flex items-center justify-center px-8 py-3 text-base font-medium rounded-lg text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
        See Features
      </a>
    </div>
  </div>
</div>

<!-- Features Section -->
<div id="features" class="bg-white py-20 sm:py-24">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
        Know your flows work before users tell you they don't
      </h2>
      <div class="mt-4 mx-auto w-12 h-1 rounded-full bg-indigo-600"></div>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Feature 1 -->
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-4 mb-3">
          <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50">
            <svg class="w-5 h-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Scheduled Browser Tests</h3>
        </div>
        <p class="text-base text-gray-600 leading-relaxed">Define critical user flows and run them on a schedule — every 5 minutes, hourly, or daily. Powered by headless Playwright.</p>
      </div>

      <!-- Feature 2 -->
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-4 mb-3">
          <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50">
            <svg class="w-5 h-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Instant Alerts</h3>
        </div>
        <p class="text-base text-gray-600 leading-relaxed">Get notified via email the moment a test fails. See exactly what went wrong with screenshots and error details.</p>
      </div>

      <!-- Feature 3 -->
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-4 mb-3">
          <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50">
            <svg class="w-5 h-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Uptime & Performance Dashboard</h3>
        </div>
        <p class="text-base text-gray-600 leading-relaxed">Track pass/fail rates, response times, and uptime across all your monitors in one place.</p>
      </div>

      <!-- Feature 4 -->
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-4 mb-3">
          <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50">
            <svg class="w-5 h-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.049.58.025 1.193-.14 1.743" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">No-Code Test Builder</h3>
        </div>
        <p class="text-base text-gray-600 leading-relaxed">Build multi-step browser tests without writing code. Point, click, and configure — your monitors are ready in minutes.</p>
      </div>
    </div>
  </div>
</div>

<!-- FAQ Section -->
<div id="faq" class="bg-gray-50 py-20 sm:py-24">
  <div class="max-w-3xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Frequently Asked Questions</h2>
      <div class="mt-4 mx-auto w-12 h-1 rounded-full bg-indigo-600"></div>
    </div>

    <div class="space-y-4">
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="text-base font-semibold text-gray-900">What is SynthMonitor?</h3>
        <p class="mt-2 text-base text-gray-600 leading-relaxed">SynthMonitor runs automated browser tests against your production application on a schedule. If a critical user flow like login, checkout, or signup breaks, you'll know about it before your customers do.</p>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="text-base font-semibold text-gray-900">What's included in the free trial?</h3>
        <p class="mt-2 text-base text-gray-600 leading-relaxed">You get 30 days of full access — no credit card required. Create monitors, set up schedules, and receive alerts just like a paid account.</p>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="text-base font-semibold text-gray-900">Can I cancel anytime?</h3>
        <p class="mt-2 text-base text-gray-600 leading-relaxed">Yes. There are no contracts or commitments. You can cancel your account at any time from your settings page.</p>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="text-base font-semibold text-gray-900">Do I need to write code to create monitors?</h3>
        <p class="mt-2 text-base text-gray-600 leading-relaxed">No. SynthMonitor includes a no-code test builder that lets you define multi-step browser flows by configuring steps like navigate, click, and fill — no scripting required.</p>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="text-base font-semibold text-gray-900">What forms of payment are accepted?</h3>
        <p class="mt-2 text-base text-gray-600 leading-relaxed">We accept all major credit cards through Stripe. No payment is required during the trial period.</p>
      </div>
    </div>
  </div>
</div>

<!-- Final CTA Section -->
<div class="bg-white py-20 sm:py-24">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
      Start monitoring in minutes
    </h2>
    <p class="mt-4 text-lg text-gray-500">
      Free 30-day trial. No credit card required.
    </p>
    <div class="mt-8">
      <%= link_to "Start Free Trial", signup_path(plan: @basic_plan.id),
            class: "inline-flex items-center justify-center px-8 py-3 text-base font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition" %>
    </div>
  </div>
</div>

<%# Newsletter section preserved but hidden — uncomment to restore
