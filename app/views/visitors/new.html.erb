<div class="container-fluid" id="News">
  <div class="row">
    <div style="margin-top:100px;" class="panel panel-default col-md-4 col-sm-6 col-sm-offset-1 col-md-offset-2 col-xs-offset-2 col-xs-5"><br/>
      <div class="panel-body">
        <h2 style="font-size: 1.8em; font-weight:bold;">Make your autoshop management easier than ever.</h2>
        <h3 class="sm-none" style="font-size: 1.3em;">
        Software that is simple to use <br>
        <br> Only takes seconds to setup <br>
        <br> Will help your business grow</h3>
          <ul style="list-style-type:none;text-align:left;">
            <li style="padding-top:35px;">
            <%= link_to "Sign Up Today", signup_path(plan: @basic_plan.id),
                                        class: 'btn btn-primary btn-lg'  %>
            </li>
            <br/>
          </ul>
        </div>
    </div>
  </div>
</div>


<div style="padding-top: 20px; background-color:#F1F2F4" class="container-fluid">

  <div class="row">

    <div style="background-color: #FFF;" class="well space landingfour landingtwo col-xl-1 col-lg-2 col-md-4 col-sm-4 ">
      <div style="font-size:3em;text-align:center;">
        <i class="glyphicon glyphicon-tasks landicon"></i>
        <h3 style="text-align:center;">Work Orders</h3>
        <h4 class="landtext">Assign tasks and keep
        your team organized. Track
        what is completed and what
        still needs done. </h4>
      </div>
    </div>

    <div style="background-color: #FFF;" class="well space col-xl-1 col-lg-2 col-md-4 col-sm-4">
      <div style="font-size:3em;text-align:center;">
        <i class="glyphicon glyphicon-road landicon"></i>
        <h3 style="text-align:center;">Vehicle Roadmap</h3>
        <h4 class="landtext">Keep track of all your vehicles and alert customers of common
        vehicle problems.</h4>
      </div>
    </div>

    <div style="background-color: #FFF;" class="well space landingtwo col-xl-1 col-lg-2 col-md-4 col-sm-4">
      <div style="font-size:3em;text-align:center;">
        <i class="glyphicon glyphicon-pencil landicon"></i>
        <h3 style="text-align:center;">Invoice Generation</h3>
        <h4 class="landtext">Generate invoices and contain a history
        of records. Customize your
        invoice to suite your needs</h4>
      </div>
    </div>

    <div style="background-color: #FFF;" class="well space col-xl-1 col-lg-2 col-md-4 col-sm-4">
      <div style="font-size:3em;text-align:center;">
        <i class="glyphicon glyphicon-search landicon"></i>
        <h3 style="text-align:center;">Part Finder</h3>
        <h4 class="landtext">Search for parts across
        the web. Find the best deals to
        help everyone save money. Ensure
        your finding the right parts for the job.</h4>
      </div>
    </div>

  </div>

  <div class="row">

    <div style="background-color: #FFF;" class="well space landingfour landingtwo col-xl-1 col-lg-2 col-md-4 col-sm-4 ">
      <div style="font-size:3em;text-align:center;">
        <i class="glyphicon glyphicon-equalizer landicon"></i>
        <h3 style="text-align:center;">Repair Estimates</h3>
        <h4 class="landtext">Build service repair estimates for
        your customers. Send the estimates by
        print or email. </h4>
      </div>
    </div>

  <div style="background-color: #FFF;" class="well space col-xl-1 col-lg-2 col-md-4 col-sm-4">
    <div style="font-size:3em;text-align:center;">
      <i class="fa fa-mobile landicon"></i>
      <h3 class="landhead" style="text-align:center;">Mobile Friendly</h3>
      <h4 class="landtext" class="landsmall">Use with your phone or tablet from
        anywhere with Wifi. Stay up to date
        with all work being done from home. </h4>
    </div>
  </div>

  <div style="background-color: #FFF;" class="well space landingtwo col-xl-1 col-lg-2 col-md-4 col-sm-4">
    <div style="font-size:3em;text-align:center;">
      <i class="fa fa-users landicon"></i>
      <h3 style="text-align:center;">Customer Portal</h3>
      <h4 class="landtext">Allow customers to submit service requests and
      view the status of their vehicles.
      </h4>
    </div>
  </div>

  <div style="background-color: #FFF;" class="well space col-xl-2 col-lg-2 col-md-4 col-sm-4">
    <div style="font-size:3em; text-align:center;">
      <i class="fa fa-database landicon"></i>
        <h3 style="text-align:center;">Data Normalization</h3>
      <h4 class="landtext">Start keeping your records organized.
      Save a history of everything your shop
      has been working on.</h4>
    </div>
  </div>

  </div>
</div>

</div>
<section class="ctawrapper">
  <div class="cta">
    <h2 class="heading">Ready to Manage Your Autoshop Business?</h2>
    <%= link_to "Try for Free", signup_path(plan: @basic_plan.id), class: 'button' %>
  </div>
</section>

<footer class="wrapper">
  <div class="inner">
    <div class="newsletter">
      <h3 class="newsletterHeading">NEWSLETTER</h3>

      <p class="newsletterBody">
        To recieve tips on how to use motivware and grow your business, sign up to our weekly
        newsletter. We’ll never send you spam or pass on your email address.
      </p>

      <form >
          <%= form_for @visitor do |f| %>
            <%= f.text_field :email, label: false, :placeholder => 'Your email address...', class: 'formEmail' %>
            <br/><br/>
            <%= f.submit "Subscribe", :class => "formButton" %>
          <% end %>
      </form>
    </div>

    <div class="about">
      <img class="logo" />
      <%= image_tag 'logo_alt.svg' %>

      <p class="aboutBody">
        Motivware is an all-in-one tool for your autoshop business designed to
        assist auto-mechanic repair shops with customer relationships and
        business processes.
      </p>

      <ul class="info">
        <li class="infoItem">
          <%= image_tag 'mail.svg', :class => "infoItemLogo" %>
          <a class="emailLink" href="mailto:support@motivware.com" >
            support@motivware.com
          </a>
        </li>
      </ul>
    </div>
  </div>

  <ul class="links">
    <li class="linkItem">
      <a  href="#"><%= link_to "FAQ", faq_path, :class => "link" %></a>
    </li>
    <li class="linkItem">
      <a class="link" href="#">Privacy Policy</a>
    </li>
    <li class="linkItem">
      <a class="link" href="#">Terms of Use</a>
    </li>
  </ul>

  <p class="copyright">
    Copyright © Motivware 2019. All Rights Reserved
  </p>
</footer>
