<div class="container-fluid" style="background-color:#B22222;">
  <div class="forms" class="row">
    <div style="height:900px;" class="col-md-4 col-md-offset-4">
      <div style="margin:250px 50px 0px 50px;padding:20px;height:300px;" class="well well-sm" >
        <% provide(:title, "Forgot password") %>
        <h1>Forgot password</h1>       
          <%= form_for(:password_reset, url: password_resets_path) do |f| %>
          <div class="field form-group">
            <%= f.label :email %>
            <%= f.text_field :email, placeholder: "Email", class: 'form-control' %>
            <%= f.submit "Submit", class: "btn btn-primary" %>
          </div>
        <% end %>        
      </div>
    </div>
  </div>
</div>
