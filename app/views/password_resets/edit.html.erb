<div class="container-fluid" style="background-color:#3E666F;">
  <div class="forms" class="row">
    <div style="height:900px;" class="col-md-6 col-md-offset-3">
      <div style="margin:250px 50px 0px 50px;padding:20px;height:400px;" class="well well-sm" >
        <% provide(:title, 'Reset password') %>
        <h1>Reset password</h1>
          <%= form_for(@user, url: password_reset_path(params[:id])) do |f| %>
            <%= render 'shared/error_messages', object: f.object %>

            <%= hidden_field_tag :email, @user.email %>

            <div class="field form-group">
              <%= f.label :password %>
              <%= f.password_field :password, class: 'form-control' %>
            </div>

            <div class="field form-group">
              <%= f.label :password_confirmation, "Confirmation" %>
              <%= f.password_field :password_confirmation, class: 'form-control' %>
            </div>

            <div class="actions form-group">
              <%= f.submit "Update password", class: "btn btn-primary" %>
            </div>
          <% end %>
      </div>
    </div>
  </div>
</div>
