<div class="container-fluid" style="background-color:#B22222;">
  <div class="forms" class="row">
      <div style="height:900px;" class="col-md-6 col-md-offset-3">
        <div style="margin:50px 50px 0px 50px;padding:20px;height:650px;" class="well well-sm" >
        <h1>Request a demo today</h1>
        <h4>Provide your inforomation and we will be in touch soon.</h3>

        <%= form_for @contact do |f| %>
          <div class='field form-group'>
            <%= f.label :name %>
            <%= f.text_field :name, placeholder: 'Full Name', class: 'form-control visitors' %>
          </div>
          <div class='field form-group'>
            <%= f.label :email %>
            <%= f.text_field :email, placeholder: 'Email', class: 'form-control visitors' %>
          </div>
          <div class='field form-group'>
            <%= f.label :comments %>
            <%= f.text_area :comments, class: 'form-control comments visitors',  placeholder: 'Anything in particular your looking to see?', cols: "30", rows: "10" %>
          </div>
            <%= f.submit 'Schedule a demo', class: 'btn btn-default' %>
        <% end %>
      </div>
    </div>
  </div>
</div>

