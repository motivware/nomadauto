
<%= render 'users/sidebar' %></br>
<div class="md:pl-64 flex flex-col flex-1">
	<main class="flex-1">
		<div class="py-6">
			<!-- This example requires Tailwind CSS v2.0+ -->
			<div class="px-4 sm:px-6 lg:px-8">
				<div class="sm:flex sm:items-center">
					<h3 class="text-lg leading-6 font-medium text-gray-900"><%= @article.subject%></h3>
					<h4 class="mt-1 max-w-2xl text-sm text-gray-500"><%= @article.author %></h4>
				</div>
					<p class="mt-1 max-w-2xl text-sm text-gray-500"><%= @article.content %></p>
					<br/>
					<a href="#" class="text-indigo-600 hover:text-indigo-900"><%= link_to 'Edit', edit_project_collection_article_path(@project, @collection, @article.id)  %></a>
			</div>
		</div>
	</main>
</div>