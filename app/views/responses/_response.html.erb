<div id="<%= dom_id response %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Questionnaire:</strong>
    <%= response.questionnaire.name %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this response", project_questionnaire_response_url(@questionnaire.project, @questionnaire, response), class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
